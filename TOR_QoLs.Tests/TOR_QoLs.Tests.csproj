<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>12</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>TOR_QoLs.Tests</RootNamespace>
    <AssemblyName>TOR_QoLs.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <!-- Линкуем TraderMath напрямую — без ProjectReference на TOR_QoLs, чтобы тесты
       не зависели от deploy в Modules/ (когда игра запущена, файл DLL занят). -->
  <ItemGroup>
    <Compile Include="..\TOR_QoLs\Behaviors\TraderMath.cs" Link="TraderMath.cs" />
  </ItemGroup>

</Project>
